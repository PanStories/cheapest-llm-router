  "tools": [
    { "name": "route", "price": "0.0005" },
    { "name": "cost_compare", "price": "0.001" },
    { "name": "list_models", "price": "0.0005" },
    { "name": "cache_route", "price": "0.0005" }
  ],
  "surfaces": [
    {
      "id": "README",
      "path": "README.md",
      "require": [
        "{version}",
        "{endpoint}",
        "{tagline.en}",
        "{tagline.zh}",
        "{tagline.zh_hant}",
