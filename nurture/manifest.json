        "{prices.all}"
      ]
    },
    {
      "id": "CHANGELOG",
      "path": "CHANGELOG.md",
      "require": ["{version}"]
    },
    {
      "id": "package json",
      "path": "package.json",
      "require": ["{version}"]
    },
    {
      "id": "actor json",
      "path": ".actor/actor.json",
      "require": ["{tools.billable}"]
    },
    {
      "id": "llms txt",
